# fe-bump. Copy to .env locally; on Vercel set the same names under Project Settings -> Environment Variables.
# Only NEXT_PUBLIC_* values belong here: they are shipped to the browser. Secrets (the Privy app secret) live in bump-backend.

# Privy (dashboard.privy.io -> app -> Settings): the app id. Add this site's origin under the app's allowed origins,
# and enable Email and Google login.
NEXT_PUBLIC_PRIVY_APP_ID=

# bump-backend origin. Locally http://localhost:3300; in production the API host on the VPS, e.g. https://api.example.com.
# That host must list this site's origin in bump-backend's BUMP_ALLOWED_ORIGINS.
NEXT_PUBLIC_API_URL=https://api.paymom3nts.xyz

# Web push public key (VAPID); the private half is in bump-backend. Leave empty to hide the notifications toggle.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
